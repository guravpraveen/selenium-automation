<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- No browser / network needed: SWIFT + DB (H2). Ideal for CI and quick practice. -->
<suite name="Offline" verbose="1">
    <listeners>
        <listener class-name="com.payments.automation.reports.TestListener"/>
        <listener class-name="com.payments.automation.reports.RetryTransformer"/>
    </listeners>
    <test name="SWIFT">
        <packages><package name="com.payments.automation.tests.swift"/></packages>
    </test>
    <test name="Database">
        <packages><package name="com.payments.automation.tests.db"/></packages>
    </test>
</suite>
