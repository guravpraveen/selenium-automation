<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- Same UI tests on Chrome, Firefox and Edge in parallel. Run: mvn test -Dsuite=cross-browser -->
<suite name="Cross Browser" parallel="tests" thread-count="3" verbose="1">
    <listeners>
        <listener class-name="com.payments.automation.reports.TestListener"/>
        <listener class-name="com.payments.automation.reports.RetryTransformer"/>
    </listeners>
    <test name="Chrome">
        <parameter name="browser" value="chrome"/>
        <classes><class name="com.payments.automation.tests.ui.LoginTest"/></classes>
    </test>
    <test name="Firefox">
        <parameter name="browser" value="firefox"/>
        <classes><class name="com.payments.automation.tests.ui.LoginTest"/></classes>
    </test>
    <test name="Edge">
        <parameter name="browser" value="edge"/>
        <classes><class name="com.payments.automation.tests.ui.LoginTest"/></classes>
    </test>
</suite>
